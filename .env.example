# Solo en el backend. Copiar a .env y completar localmente.
OPENAI_API_KEY=
TOKKO_API_KEY=
# Modelo con Responses API y function calling; cambiar según el acceso de tu cuenta.
OPENAI_MODEL=gpt-4.1-mini
PORT=8787
HOST=127.0.0.1

# Diagnóstico local en consola, sin mensajes ni argumentos. 0 = apagado.
AGENT_DIAGNOSTICS=0
